    "@streamdown/code": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.164",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "monaco-editor": "^0.57.0",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
