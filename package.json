    "e2e:chat": "node scripts/e2e-chat.mjs",
    "e2e:ide": "node scripts/e2e-ide.mjs",
    "e2e:platform": "node scripts/e2e-platform.mjs",
    "e2e:research": "node scripts/e2e-research.mjs",
    "e2e:models": "node scripts/e2e-models.mjs",
    "e2e:auth": "node scripts/e2e-auth.mjs",
    "e2e:plans": "node scripts/e2e-plans.mjs",
    "admin:bootstrap": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/admin-bootstrap.mjs",
