{
  "name": "harbor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-monaco.mjs && next dev",
    "build": "node scripts/copy-monaco.mjs && next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
