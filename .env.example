AUTH_SECRET=replace-with-a-long-random-string
# Public URL. Set it in production (behind the TLS proxy); leave it unset for
# local and LAN use so sign-in works on whichever address each device uses.
# AUTH_URL=https://chat.conzex.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Default admin, created on startup if it does not exist yet. It must choose a
# new password on first sign-in. ADMIN_EMAIL can be an email or a username.
# Never put the plain password here. Generate the line with:
#   npm run hash-password
# and keep every $ escaped as \$ (Next.js expands unescaped $ in .env files).
# ADMIN_EMAIL=admin
# ADMIN_PASSWORD_HASH=\$2b\$12\$...

# Extra comma-separated emails promoted to admin on startup.
# ADMIN_EMAILS=you@example.com

# IDE workspaces (admin-only). Each workspace is a folder in here; deleted files
# and workspaces go to its .trash folder. Defaults to DATA_DIR/workspaces.
# The IDE terminal runs as the server's OS user, so run the app as a dedicated
# unprivileged user.
# WORKSPACES_ROOT=/srv/conzex/workspaces
