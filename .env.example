AUTH_SECRET=replace-with-a-long-random-string
# Public URL. Set it in production (behind the TLS proxy); leave it unset for
# local and LAN use so sign-in works on whichever address each device uses.
# AUTH_URL=https://chat.conzex.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Encrypts provider API keys at rest. Optional: when unset, keys are derived
# from AUTH_SECRET, and changing AUTH_SECRET makes saved keys unreadable.
# SECRETS_KEY=another-long-random-string

# First-run Super Administrator, created on startup if it does not exist yet.
# It signs in with ADMIN_USERNAME (default "admin") or ADMIN_EMAIL and must
# choose a new password on first sign-in. Public registration never creates
# admins. Never put the plain password here. Generate the hash line with:
#   npm run hash-password
# and keep every $ escaped as \$ (Next.js expands unescaped $ in .env files).
# To turn an existing account into the Super Administrator, or recover it, run
# `npm run admin:bootstrap` on the server instead.
# ADMIN_EMAIL=you@example.com
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=\$2b\$12\$...

# IDE workspaces (admin-only). Each workspace is a folder in here; deleted files
# and workspaces go to its .trash folder. Defaults to DATA_DIR/workspaces.
# The IDE terminal runs as the server's OS user, so run the app as a dedicated
# unprivileged user.
# WORKSPACES_ROOT=/srv/xai/workspaces

# Chat Search mode (DeepSeek-style Globe toggle). Set exactly one provider.
# When SEARCH_PROVIDER is unset, Search shows as unavailable — there is no
# silent fallback. Deep Research still uses Admin → Research sources.
# SEARCH_PROVIDER=searxng
# SEARXNG_URL=http://127.0.0.1:8080
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
