AUTH_SECRET=replace-with-a-long-random-string
# Leave unset to accept the host each device uses (localhost, LAN IP, domain).
# Set it to the public HTTPS URL when the app runs behind a reverse proxy.
# AUTH_URL=https://chat.example.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:14b
# Comma-separated emails allowed to download and remove models.
# When unset, the first account created on this server is the admin.
# ADMIN_EMAILS=you@example.com
